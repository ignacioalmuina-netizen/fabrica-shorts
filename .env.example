# Copia este archivo como .env y rellena tus claves. NUNCA subas .env a GitHub.

# Paso 1 · YouTube Data API v3 (búsqueda de tendencias) — Google Cloud Console
YOUTUBE_API_KEY=

# Paso 3 · Voz ElevenLabs (opcional: sin ella se usa edge-tts gratis)
ELEVENLABS_API_KEY=

# Paso 4 · Vídeo de stock vertical (gratis) — https://www.pexels.com/api/
PEXELS_API_KEY=

# Paso 4 · Imágenes IA GRATIS (Cloudflare Workers AI, ~80-90 imágenes/día, cuenta sin tarjeta)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Paso 4 · Imágenes IA de pago, mejor calidad (opcional)
OPENAI_API_KEY=
